# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
vendor/

# Rust
/target/
Cargo.lock
**/*.rs.bk

# PHP
vendor/
composer.phar
.phpunit.result.cache

# Ruby
*.gem
.bundle/
vendor/bundle/

# C / C++
*.o
*.obj
*.exe
*.a
*.so
*.dll
*.dylib
build/
cmake-build-*/

# ---- 测试产物 ----
test-results/
junit.xml
cucumber.xml
*.test-results

# ---- 密钥 / 敏感信息 ----
